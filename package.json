{
  "name": "nutripey",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
