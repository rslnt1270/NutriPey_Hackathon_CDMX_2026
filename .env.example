# Copiar a .env.local y completar. Nunca subir valores reales al repo.
# Los nombres definitivos se confirman en el PR de esqueleto.

# Base de datos
DATABASE_URL=

# pey (https://docs.pey.mx). No hay sandbox: probar solo con $0.01 MXN.
# Usar una API key distinta para desarrollo y para la demo.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_BANK_ACCOUNT_ID=

# Aplicación
APP_URL=http://localhost:3000
SESSION_SECRET=
CRON_SECRET=

# Solo pruebas: PostgreSQL local desechable, base llamada nutripey_test.
# Nunca apuntar a una base de desarrollo compartida ni producción.
TEST_DATABASE_URL=

# Rol limitado de aplicación; distinto de POSTGRES_PASSWORD (administración).
APP_DATABASE_PASSWORD=
